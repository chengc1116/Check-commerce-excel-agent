# ===========================================
# 项目立项审核Agent - 环境变量配置
# 复制此文件为 .env 后修改为你自己的值
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/Mac)
# ===========================================

# ---- LLM 基础配置 ----
# SiliconFlow API Key（必填，从 https://cloud.siliconflow.cn 获取）
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=20000

# ---- 文本模型（深度分析用）----
LLM_MODEL=Pro/zai-org/GLM-5

# ---- 快速文本模型（Excel解析等简单提取场景）----
LLM_FAST_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---- 视觉模型（多模态图片分析）----
LLM_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---- 飞书 Bot 配置（可选，不用飞书可不填）----
# 从飞书开放平台获取: https://open.feishu.cn/app
# 1. 创建应用 → 开启机器人能力
# 2. 事件订阅选择"使用长连接接收事件"
# 3. 添加事件: im.message.receive_v1
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_MODE=websocket

# ---- Web 服务配置（可选，有默认值）----
# HOST=0.0.0.0
# WEB_PORT=8080
# DEBUG=true
# UPLOAD_DIR=./uploads
